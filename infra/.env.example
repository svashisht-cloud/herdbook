# Copy to .env (which git ignores) and change the passwords.
MQTT_USER=fleet
MQTT_PASSWORD=change-me-mqtt

POSTGRES_USER=fleet
POSTGRES_PASSWORD=change-me-pg
POSTGRES_DB=fleet

# MinIO needs a user of 3+ characters and a password of 8+.
MINIO_ROOT_USER=fleetadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=incidents

# Robot upload user: minio-init gives it PutObject on the bucket only (no root keys on robots).
MINIO_ROBOT_USER=fleetrobot
MINIO_ROBOT_PASSWORD=change-me-robot
